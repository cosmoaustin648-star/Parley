# ─────────────────────────────────────────────────────────────
# Parley configuration. Copy to `.env` and adjust.
# Real environment variables always win over values in this file.
# ─────────────────────────────────────────────────────────────

# development | production | test
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public URL people use to reach Parley. Used in emails and invite links,
# and to validate the Origin header of browser requests and WebSocket upgrades.
APP_URL=http://localhost:3000

# PostgreSQL 14+ (16 recommended). For managed databases add ?sslmode=require
DATABASE_URL=postgres://parley:parley_dev_pw@127.0.0.1:5432/parley
DB_POOL_MAX=10

# Set to true behind a reverse proxy (nginx, Caddy, a PaaS load balancer) so
# client IPs come from X-Forwarded-For for rate limiting and session records.
TRUST_PROXY=false
# Secure cookies (HTTPS only). Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
SESSION_DAYS=30

# When true, unverified accounts can't send messages, create/join servers or open DMs.
# Recommended in production once SMTP works.
REQUIRE_EMAIL_VERIFICATION=false

# ── Email (verification + password reset) ──
# Without SMTP_HOST, development keeps emails in memory: GET /api/dev/outbox.
# In production SMTP is required for those flows.
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (usually port 465). false = upgrade with STARTTLS when offered.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Parley <no-reply@example.com>

# ── File storage ──
# Uploads are stored on disk here and only served through access-checked routes.
STORAGE_DIR=./data/uploads
MAX_UPLOAD_MB=25

# ── Voice & video (WebRTC) ──
# STUN lets most peers find each other. Many corporate/mobile networks also need
# a TURN relay (e.g. coturn). Either list servers directly as JSON:
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
# …or give coturn's static-auth-secret and Parley issues short-lived credentials per user:
TURN_SECRET=
TURN_URLS=
# e.g. TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# Full-mesh calls get heavy past ~6–8 people; see docs/DEPLOYMENT.md for an SFU.
MAX_VOICE_PARTICIPANTS=8

# Comma-separated emails that become platform staff on sign-up (can review DM
# reports via /api/staff/reports and suspend accounts).
STAFF_EMAILS=

# Tests use a separate database that is wiped on every run.
TEST_DATABASE_URL=postgres://parley:parley_dev_pw@127.0.0.1:5432/parley_test
