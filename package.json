{
  "name": "parley",
  "version": "0.1.0",
  "private": true,
  "description": "Parley \u2014 a self-hostable community chat platform with servers, channels, DMs, roles and voice/video.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "migrate": "tsx server/db/migrate-cli.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/api/*.test.ts",
    "test:e2e": "node --import tsx --test --test-concurrency=1 tests/e2e/*.test.ts",
    "test:all": "npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "ws": "8.21.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "playwright": "1.56.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
